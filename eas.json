{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_CLOUD_URL": "https://wsclienticloudtest.skyoneserver.it"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_CLOUD_URL": "https://wsclienticloudtest.skyoneserver.it"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_CLOUD_URL": "https://wsclienticloud.skyoneserver.it"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
